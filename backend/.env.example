APP_NAME=flexd-jobx-web
APP_ENV=local
APP_API_PREFIX=/api/v1
APP_CORS_ORIGINS=["http://localhost:5173"]
APP_LOG_LEVEL=INFO
APP_LOGIN_RATE_LIMIT=10
APP_LOGIN_WINDOW_SECONDS=60
APP_REGISTER_RATE_LIMIT=5
APP_REGISTER_WINDOW_SECONDS=60
# OAuth uses in-memory state and supports one process in local/test environments only.
APP_GITHUB_CLIENT_ID=
APP_GITHUB_CLIENT_SECRET=
APP_GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
APP_GITHUB_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/github/callback

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jobx
DB_USER=flexd
DB_PASSWORD=
DB_TLS_ENABLED=false
DB_CONNECT_TIMEOUT_SECONDS=10
# Tests only: dedicated schema ending in _test; never point at application DB.
DB_TEST_URL=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=flexd-jobx-web
JWT_AUDIENCE=flexd-jobx-web
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

STORAGE_CLOUD_PROVIDER=aws
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=flexd
STORAGE_PATH=/jobx
STORAGE_PUBLIC_URL=https://flexd.s3.ap-southeast-1.amazonaws.com/jobx
STORAGE_ACL=false

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
